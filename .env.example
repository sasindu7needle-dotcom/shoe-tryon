APP_NAME="Shoe Try-On"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite keeps a small VPS free of a database service. Point DB_DATABASE at a
# file inside the mounted volume in production, e.g. /app/storage/app/database.sqlite
DB_CONNECTION=sqlite
# DB_DATABASE=/app/storage/app/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Required when serving over HTTPS (production)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Virtual try-on ───────────────────────────────────────────────────────────
# Foot tracking model. NN_FOOT_31 (19 MB) handles shoes, socks and bare feet;
# NN_BAREFOOT_3 (1.3 MB) is much smaller but bare feet only.
TRYON_NEURAL_NETWORK=vendor/webar-rocks/neural-nets/NN_FOOT_31.json
# Detection sensitivity 0-1: lower finds feet sooner, higher is stricter.
TRYON_DETECTION_THRESHOLD=0.8
# Assumed vertical camera field of view in degrees; tune if shoes sit at an angle.
TRYON_CAMERA_FOV=33
# Render resolution cap on high-DPI phones.
TRYON_MAX_DPR=1.5
# Bump after changing anything under public/vendor or public/models (cache busting).
TRYON_ASSET_VERSION=2
TRYON_MAX_MODEL_UPLOAD_KB=25600
TRYON_MAX_POSTER_UPLOAD_KB=2048
# Comma-separated origins allowed to embed /try-on pages in an iframe.
TRYON_EMBED_ORIGINS=

# Set when TLS terminates in front of the app (Cloudflare, load balancer): * or a list.
# TRUSTED_PROXIES=*

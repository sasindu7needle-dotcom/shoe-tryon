# Copy to .env on the server, fill in, then: docker compose up -d --build
# Generate the key once with: docker compose run --rm app php artisan key:generate --show
APP_NAME="Shoe Try-On"
APP_KEY=
APP_URL=https://tryon.example.com

# Your domain, so Caddy gets a Let's Encrypt certificate automatically.
# Use ":80" instead to serve plain HTTP (behind your own proxy or for testing).
# Live try-on needs HTTPS: browsers refuse camera access otherwise.
SERVER_NAME=tryon.example.com
TLS_EMAIL=you@example.com

SESSION_SECURE_COOKIE=true
LOG_LEVEL=warning

# Bump after changing anything in public/vendor or public/models.
TRYON_ASSET_VERSION=1
# Detection sensitivity 0-1: lower finds feet sooner, higher is stricter.
TRYON_DETECTION_THRESHOLD=0.8
# Assumed vertical camera field of view; tune if shoes sit at an angle on real phones.
TRYON_CAMERA_FOV=33
# Origins allowed to embed /try-on pages, e.g. https://shop.example
TRYON_EMBED_ORIGINS=

# Set to * only when another proxy (Cloudflare, load balancer) terminates TLS.
TRUSTED_PROXIES=
